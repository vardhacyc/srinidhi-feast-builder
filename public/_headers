# Netlify/Vercel headers for browser caching and compression

# Enable compression for all resources
/*
  Content-Encoding: gzip

# Cache static assets for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year
*.jpg
  Cache-Control: public, max-age=31536000, immutable

*.jpeg
  Cache-Control: public, max-age=31536000, immutable

*.png
  Cache-Control: public, max-age=31536000, immutable

*.webp
  Cache-Control: public, max-age=31536000, immutable

*.avif
  Cache-Control: public, max-age=31536000, immutable

*.gif
  Cache-Control: public, max-age=31536000, immutable

# Cache SVG for 1 year
*.svg
  Cache-Control: public, max-age=31536000, immutable

# Cache favicon and icons
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=31536000, immutable

# Cache JS and CSS with hash for long-term caching
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML - shorter cache for dynamic content
/*.html
  Cache-Control: public, max-age=3600, s-maxage=86400

# Disable cache for service worker
/sw.js
  Cache-Control: no-cache
